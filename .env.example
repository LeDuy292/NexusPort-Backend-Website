# ==============================================================================
# NexusPort Backend Environment Variables
# ==============================================================================

# Application Environment
NODE_ENV=development
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexusport
DB_USER=postgres
DB_PASSWORD=pgadmin4
DATABASE_URL=postgresql://postgres:pgadmin4@localhost:5432/nexusport

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=NexusRedis2026!
REDIS_URL=redis://:NexusRedis2026!@localhost:6379

# RabbitMQ Message Broker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=nexusport_admin
RABBITMQ_PASS=NexusRabbit2026!

# JWT Authentication
JWT_SECRET=NexusPort_Super_Secret_Key_For_Jwt_Authentication_2026!
JWT_ISSUER=NexusPort
JWT_AUDIENCE=NexusPortClients
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Server Ports
CSHARP_API_PORT=5000
NODE_CORE_PORT=4000
