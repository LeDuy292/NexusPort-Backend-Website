# NexusPort Backend — Environment Variables Template
# Copy file này thành .env và điền giá trị thực

# ─── Server ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── PostgreSQL Database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexusport
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── JWT ──────────────────────────────────────────────────────────
# Đặt một chuỗi ngẫu nhiên dài ít nhất 32 ký tự
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars_here
JWT_EXPIRES_IN=8h

# ─── Bcrypt ───────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
