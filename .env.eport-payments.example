# Copy to .env.eport-payments.local. The local file is excluded from Git.
# Get these three values from your PayOS payment channel. Never send them in chat.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Local development frontend. Use your real HTTPS frontend when deployed.
PAYOS_RETURN_URL=http://localhost:5173/service-orders
PAYOS_CANCEL_URL=http://localhost:5173/service-orders

# Your public HTTPS backend endpoint, used only by explicit RegisterWebhook mode.
# Leave blank until the backend has a public HTTPS domain/tunnel.
PAYOS_WEBHOOK_URL=
